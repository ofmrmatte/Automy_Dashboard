DATABASE_URL=
# Railway runtime interno: require. TCP Proxy local/Vercel: disable.
PGSSLMODE=disable
BETTER_AUTH_SECRET=
# URL canonica: app.automy.dev.br em producao; localhost em desenvolvimento.
BETTER_AUTH_URL=
# Origens adicionais do ERP separadas por virgula. Evite wildcards amplos.
# Producao: https://app.automy.dev.br,https://automy-dashboard.vercel.app
AUTOMY_TRUSTED_ORIGINS=
BETTER_AUTH_API_KEY=
BETTER_AUTH_API_URL=
BETTER_AUTH_KV_URL=
PGHOST=
PGDATABASE=
PGUSER=
PGPORT=
RAILWAY_ENVIRONMENT=
CNPJ_PROVIDER=cnpj_ws
CNPJ_WS_MODE=public
CNPJ_WS_API_URL=https://publica.cnpj.ws
CNPJ_WS_API_TOKEN=
CNPJ_LOOKUP_CACHE_MS=86400000
CNPJ_LOOKUP_RATE_LIMIT=3
CNPJ_LOOKUP_TIMEOUT_MS=8000
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
